import QtQuick
import Quickshell
import Quickshell.Io
import "WallpaperFiles.js" as Files

Scope {
    id: root

    required property string destination
    property string image: ""
    property string scheme: "scheme-wallpaper"
    property string mode: "dark"
    property string presetFile: ""
    property string fallbackPresetFile: ""
    property bool canPublish: true
    property int revision: 0

    readonly property string request: image || presetFile ? JSON.stringify([
        destination, image, scheme, mode, presetFile, fallbackPresetFile, revision
    ]) : ""
    readonly property bool ready: request !== "" && publishedRequest === request
    readonly property bool failed: request !== "" && failedRequest === request
    readonly property string resultText: ready ? generatedText : ""
    property string generatedRequest: ""
    property string generatedText: ""
    property string publishedRequest: ""
    property string failedRequest: ""
    property string runningRequest: ""
    property string savingRequest: ""

    onRequestChanged: {
        publishedRequest = "";
        failedRequest = "";
        generatedRequest = "";
        generatedText = "";
        schedule.restart();
    }
    onCanPublishChanged: if (canPublish) Qt.callLater(publish)

    function refresh(): void {
        revision++;
    }

    function start(): void {
        if (!request || generator.running || savingRequest)
            return;
        if (generatedRequest === request) {
            publish();
            return;
        }

        runningRequest = request;
        if (presetFile) {
            generator.command = ["python3",
                Files.localPath(Qt.resolvedUrl("../../../../scripts/preset_palette.py")),
                presetFile, fallbackPresetFile];
        } else {
            generator.command = ["bash",
                Files.localPath(Qt.resolvedUrl("../../../../scripts/generate_wallpaper_colors.sh")),
                image, scheme, mode,
                Files.localPath(Qt.resolvedUrl("../../../../assets/matugen/config.toml")), "-"];
        }
        generator.running = true;
    }

    function publish(): void {
        if (!canPublish || request === "" || generatedRequest !== request || ready || savingRequest)
            return;
        // FileView skips its save signal when the generated bytes match.
        if (writer.text() === generatedText) {
            publishedRequest = request;
        } else {
            savingRequest = request;
            writer.setText(generatedText);
        }
    }

    Timer {
        id: schedule
        interval: 60
        onTriggered: root.start()
    }

    Process {
        id: generator
        stdout: StdioCollector { id: output }
        stderr: StdioCollector { id: errors }

        onExited: exitCode => {
            if (root.runningRequest !== root.request) {
                schedule.restart();
                return;
            }
            if (exitCode !== 0 || !output.text) {
                console.warn("Wallpaper colors:", errors.text.trim());
                root.failedRequest = root.runningRequest;
                return;
            }
            root.failedRequest = "";
            root.generatedRequest = root.runningRequest;
            root.generatedText = output.text;
            root.publish();
        }
    }

    FileView {
        id: writer
        path: root.destination
        atomicWrites: true
        blockWrites: true
        printErrors: false
        onSaved: {
            if (root.savingRequest === root.request)
                root.publishedRequest = root.savingRequest;
            else
                schedule.restart();
            root.savingRequest = "";
        }
        onSaveFailed: error => {
            console.warn("Wallpaper colors: could not save", path, error);
            if (root.savingRequest !== root.request)
                schedule.restart();
            else
                root.failedRequest = root.savingRequest;
            root.savingRequest = "";
        }
    }
}
