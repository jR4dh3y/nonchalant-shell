import QtQuick
import Quickshell
import Quickshell.Io

// Writes window chrome colors for Niri. The Niri profile includes this file
// after its own layout block; Niri merges the sections and hot-reloads on
// change. Only colors are set, so on/off and widths stay owned by the profile.
// The file also carries the layer rule that puts the shell's blurred
// wallpaper surface into Niri's overview backdrop.
QtObject {
    id: root

    readonly property string outputPath: Quickshell.env("HOME") + "/.cache/nonchalant/niri-colors.kdl"
    // Must match OverviewBackdrop's WlrLayershell.namespace.
    readonly property string overviewBackdropNamespace: "^nonchalant:overview-backdrop$"

    // Niri reads CSS-style #rrggbbaa; QML's color.toString() emits #aarrggbb.
    function hex(c: color, alpha: real): string {
        const channel = value => Math.round(value * 255).toString(16).padStart(2, "0");
        return `"#${channel(c.r)}${channel(c.g)}${channel(c.b)}${channel(alpha)}"`;
    }

    function generate(Colors) {
        if (!Colors)
            return;

        const active = hex(Colors.primary, 1);
        const inactive = hex(Colors.outlineVariant, 1);
        const urgent = hex(Colors.error, 1);

        let conf = "// Generated by Nonchalant from the current palette. Do not edit.\n";
        conf += "layout {\n";
        conf += `    focus-ring {\n        active-color ${active}\n        inactive-color ${inactive}\n        urgent-color ${urgent}\n    }\n`;
        conf += `    border {\n        active-color ${active}\n        inactive-color ${inactive}\n        urgent-color ${urgent}\n    }\n`;
        conf += `    tab-indicator {\n        active-color ${active}\n        inactive-color ${inactive}\n        urgent-color ${urgent}\n    }\n`;
        conf += `    insert-hint {\n        color ${hex(Colors.primary, 0.5)}\n    }\n`;
        conf += "}\n";
        conf += `recent-windows {\n    highlight {\n        active-color ${active}\n        urgent-color ${urgent}\n    }\n}\n`;
        // The shell creates this surface only while the overview wallpaper
        // blur setting is on; the rule is inert otherwise.
        conf += `layer-rule {\n    match namespace="${root.overviewBackdropNamespace}"\n    place-within-backdrop true\n}\n`;

        // Write atomically so Niri never reloads a half-written file.
        const command = ["sh", "-c", 'mkdir -p "$(dirname "$2")" && printf "%s" "$1" > "$2.tmp" && mv "$2.tmp" "$2"', "sh", conf, root.outputPath];
        // A running Process keeps its original command, so writes are queued:
        // the newest palette replaces any pending one and starts once the
        // current write exits. A command stays pending until it starts, so
        // "not running and nothing pending" always means idle.
        root.pendingCommand = command;
        root.startPending();
    }

    property list<string> pendingCommand: []

    function startPending(): void {
        if (writerProcess.running || root.pendingCommand.length === 0)
            return;
        writerProcess.command = root.pendingCommand;
        root.pendingCommand = [];
        writerProcess.running = true;
    }

    property Process writerProcess: Process {
        id: writerProcess
        running: false
        // Restart outside the exit handler, after the Process has settled.
        onExited: Qt.callLater(root.startPending)
        stderr: StdioCollector {
            onStreamFinished: {
                if (text)
                    console.error("NiriGenerator Error:", text);
            }
        }
    }
}
